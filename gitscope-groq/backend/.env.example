# GitScope AI - Backend Environment Variables

# Groq API Key (required) - Get from https://console.groq.com
GROQ_API_KEY=gsk_...your-groq-key-here...

# Groq Model (fast + free options)
# Options: llama3-8b-8192 | llama3-70b-8192 | mixtral-8x7b-32768 | gemma2-9b-it
GROQ_MODEL=llama3-70b-8192

# GitHub Personal Access Token (recommended for higher rate limits)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...your-github-token...

# Server Settings
HOST=0.0.0.0
PORT=8000
